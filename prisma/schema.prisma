generator client { provider = "prisma-client-js" }
datasource db { provider = "sqlite" url = env("DATABASE_URL") }
model User { id String @id @default(cuid()); email String @unique; createdAt DateTime @default(now()) @map("created_at"); twitterTokens TwitterToken[]; scheduledPosts ScheduledPost[]; autoDmCampaigns AutoDmCampaign[]; @@map("users") }
model TwitterToken { id String @id @default(cuid()); userId String @map("user_id"); twitterUserId String @map("twitter_user_id"); accessToken String @map("access_token"); refreshToken String @map("refresh_token"); expiresAt DateTime @map("expires_at"); scope String?; isPremium Boolean @default(false) @map("is_premium"); createdAt DateTime @default(now()) @map("created_at"); updatedAt DateTime @updatedAt @map("updated_at"); user User @relation(fields:[userId],references:[id],onDelete:Cascade); @@index([userId]); @@map("twitter_tokens") }
model ScheduledPost { id String @id @default(cuid()); userId String @map("user_id"); content String; scheduledAt DateTime @map("scheduled_at"); status String @default("PENDING"); xTweetId String? @map("x_tweet_id"); errorMessage String? @map("error_message"); createdAt DateTime @default(now()) @map("created_at"); updatedAt DateTime @updatedAt @map("updated_at"); user User @relation(fields:[userId],references:[id],onDelete:Cascade); autoDmCampaign AutoDmCampaign?; @@index([userId]); @@index([status]); @@index([scheduledAt]); @@map("scheduled_posts") }
model AutoDmCampaign { id String @id @default(cuid()); userId String @map("user_id"); parentTweetId String @map("parent_tweet_id"); triggerKeyword String @map("trigger_keyword"); dmMessage String @map("dm_message"); isActive Boolean @default(true) @map("is_active"); lastPolledAt DateTime? @map("last_polled_at"); createdAt DateTime @default(now()) @map("created_at"); updatedAt DateTime @updatedAt @map("updated_at"); scheduledPostId String? @unique @map("scheduled_post_id"); scheduledPost ScheduledPost? @relation(fields:[scheduledPostId],references:[id],onDelete:SetNull); user User @relation(fields:[userId],references:[id],onDelete:Cascade); dmLogs DmLog[]; @@index([userId]); @@index([isActive]); @@map("auto_dm_campaigns") }
model DmLog { id String @id @default(cuid()); campaignId String @map("campaign_id"); recipientTwitterId String @map("recipient_twitter_id"); sentAt DateTime @default(now()) @map("sent_at"); replyText String? @map("reply_text"); replyTweetId String? @map("reply_tweet_id"); campaign AutoDmCampaign @relation(fields:[campaignId],references:[id],onDelete:Cascade); @@unique([campaignId,recipientTwitterId]); @@index([campaignId]); @@map("dm_logs") }